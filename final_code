@app.route('/api/cumulative_discussions')
def api_cumulative_discussions():
    if 'admin' not in session and 'dealer' not in session:
        return jsonify({'html': '<div style="color:red;padding:20px">Unauthorized</div>'})

    pi = request.args.get('pi', '').strip()
    if not pi:
        return jsonify({'html': '<div style="padding:20px;color:var(--text-muted)">No PI number specified.</div>'})

    conn = get_db()
    cur = dict_cursor(conn)
    cur.execute("""
        SELECT d.*, s."Part_Name", s."Part_Number", s."Model", s.dealer_id, s.status as shipment_status
        FROM "Discussion" d
        JOIN shipments s ON s."Sl_No" = d.shipment_id
        WHERE d.pi_number = %s
        ORDER BY d.shipment_id ASC, d."Sl_No" ASC
    """, (pi,))
    rows = cur.fetchall()
    conn.close()

    if not rows:
        return jsonify({'html': f'<div style="padding:24px;text-align:center;color:var(--text-muted)">No discussions found for PI: <strong>{pi}</strong></div>'})

    groups = OrderedDict()
    for r in rows:
        sid = r['shipment_id']
        if sid not in groups:
            groups[sid] = {'info': r, 'msgs': []}
        groups[sid]['msgs'].append(r)

    html_parts = ["""
    <div class="cum-header-row">
      <div class="cum-header-cell" style="justify-content:center">#</div>
      <div class="cum-header-cell">Author</div>
      <div class="cum-header-cell">Role</div>
      <div class="cum-header-cell">PI Number</div>
      <div class="cum-header-cell">Message</div>
    </div>"""]

    global_row = 0
    for sid, grp in groups.items():
        info = grp['info']
        part_name = info.get('Part_Name') or '—'
        part_no   = info.get('Part_Number') or '—'
        model     = info.get('Model') or '—'
        dealer_id = info.get('dealer_id') or '—'
        s_status  = info.get('shipment_status') or 'Open'

        section_label = f"{part_name} &nbsp;|&nbsp; <code>{part_no}</code> &nbsp;|&nbsp; {model} &nbsp;|&nbsp; Dealer: <strong style='color:var(--red-main)'>{dealer_id}</strong>"
        status_html = f'<span class="status-badge {get_status_css_class(s_status)}" style="font-size:0.68rem">{s_status}</span>'

        html_parts.append(f"""
        <div class="cum-section-divider">
          &#128230; {section_label}
          <span class="cum-sec-badge">{status_html}</span>
          <span class="cum-sec-badge">&#128172; {len(grp['msgs'])} message(s)</span>
        </div>""")

        for msg in grp['msgs']:
            global_row += 1
            deleted = msg['is_deleted'] == 1
            author_role = msg['author_role'] or ''
            role_cls = ''.join(c for c in author_role if c.isalnum())
            display_role = 'TSD' if author_role == 'General' else author_role
            pi_cell = f'<span class="pi-badge">{msg["pi_number"]}</span>' if msg.get('pi_number') else '—'

            if deleted:
                msg_html = '<span style="color:var(--text-light);font-style:italic">&#128465; Deleted</span>'
            else:
                msg_html = f'<span class="cum-msg-text">{msg["message"] or ""}</span>'

            meta = f'<div class="cum-msg-meta">{msg["created_at"] or ""}</div>'
            row_bg = 'background:#fafafa' if deleted else ''

            html_parts.append(f"""
            <div class="cum-chat-row" style="{row_bg}">
              <div class="cum-cell cum-cell-rownum">{global_row}</div>
              <div class="cum-cell cum-cell-author">
                <span class="cum-author-name">{msg['author_name'] or 'Unknown'}</span>
                <span class="cum-author-handle">@{msg['author_username'] or ''}</span>
              </div>
              <div class="cum-cell cum-cell-role">
                <span class="role-tag role-{role_cls}" style="font-size:0.67rem">{display_role}</span>
              </div>
              <div class="cum-cell cum-cell-pi">{pi_cell}</div>
              <div class="cum-cell cum-cell-message">
                {msg_html}
                {meta}
              </div>
            </div>""")

    return jsonify({'html': ''.join(html_parts)})


