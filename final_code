def get_status_css_class(status):
    if not status: return 'status-Open'
    clean = status.replace(' ', '').replace(':', '').replace('-', '')
    return f'status-{clean}'

def status_badge(status):
    css = get_status_css_class(status or 'Open')
    label = status or 'Open'
    return f'<span class="status-badge {css}">{label}</span>'

def compute_lead_time_detail(date_sent_str):
    if not date_sent_str:
        return None, False, 0
    try:
        d = datetime.strptime(str(date_sent_str).strip(), "%Y-%m-%d")
        lead = d + timedelta(days=3)
        now = datetime.now()
        diff = (now.date() - lead.date()).days
        is_crossed = diff > 0
        return lead.strftime("%Y-%m-%d"), is_crossed, diff
    except Exception:
        return None, False, 0

def lead_time_badge(date_sent_str):
    lead_date, crossed, diff = compute_lead_time_detail(date_sent_str)
    if not lead_date:
        return '<span style="color:var(--text-light);font-size:0.73rem">—</span>'
    if crossed:
        days_over = diff
        days_label = f"{days_over} day{'s' if days_over != 1 else ''} crossed"
        return (f'<span class="lead-crossed">&#9888; {lead_date} &mdash; '
                f'<strong>{days_label}</strong></span>')
    elif diff == 0:
        return f'<span class="lead-ok">&#9888; {lead_date} &mdash; Due today</span>'
    else:
        days_left = abs(diff)
        days_label = f"{days_left} day{'s' if days_left != 1 else ''} left"
        return f'<span class="lead-ok">&#10003; {lead_date} &mdash; {days_label}</span>'

