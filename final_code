@app.route('/api/all_parts_discussions')
def api_all_parts_discussions():
    """Return a summary table of ALL shipments with their discussion messages,
    grouped by shipment. Each row shows total / active / deleted message counts
    and the last message preview. Clicking expands inline to show all messages."""
    if 'admin' not in session and 'dealer' not in session:
        return jsonify({'html': '<div style="color:red;padding:20px">Unauthorized</div>'})

    conn = get_db()
    cur = dict_cursor(conn)

    # All shipments (not deleted) with their discussion counts
    cur.execute("""
        SELECT
            s."Sl_No",
            s."Part_Name",
            s."Part_Number",
            s."Model",
            s.dealer_id,
            s.status,
            s."Date_sent",
            s."PIC",
            COUNT(d."Sl_No")                                          AS total_msgs,
            COUNT(d."Sl_No") FILTER (WHERE d.is_deleted = 0)         AS active_msgs,
            COUNT(d."Sl_No") FILTER (WHERE d.is_deleted = 1)         AS deleted_msgs,
            MAX(d.created_at) FILTER (WHERE d.is_deleted = 0)        AS last_msg_at
        FROM shipments s
        LEFT JOIN "Discussion" d ON d.shipment_id = s."Sl_No"
        WHERE s.is_deleted = 0
        GROUP BY s."Sl_No", s."Part_Name", s."Part_Number", s."Model",
                 s.dealer_id, s.status, s."Date_sent", s."PIC"
        ORDER BY total_msgs DESC, s."Sl_No" DESC
    """)
    shipments = cur.fetchall()

    # All discussions for all those shipments in one query
