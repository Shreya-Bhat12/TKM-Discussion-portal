def compute_lead_time(date_sent_str):
    if not date_sent_str:
        return None, False
    try:
        d = datetime.strptime(str(date_sent_str).strip(), "%Y-%m-%d")
        lead = d + timedelta(days=3)
        is_crossed = datetime.now() > lead
        return lead.strftime("%Y-%m-%d"), is_crossed
    except Exception:
        return None, False


def lead_time_badge(date_sent_str):
    lead_date, crossed = compute_lead_time(date_sent_str)
    if not lead_date:
        return '<span style="color:var(--text-light);font-size:0.75rem">—</span>'
    if crossed:
        return f'<span class="lead-crossed">&#9888; Lead Time Crossed <small>({lead_date})</small></span>'
    return f'<span class="lead-ok">&#10003; {lead_date}</span>'


def status_counts_html(counts_dict):
    parts = []
    mapping = [
        ('Open',             'sc-pill sc-open',   '&#11044;'),
        ('Inprogress',       'sc-pill sc-inp',    '&#9654;'),
        ('Inprogress : TSD', 'sc-pill sc-inptsd', '&#9654;'),
        ('Closed',           'sc-pill sc-closed', '&#9632;'),
    ]
    for status, css, icon in mapping:
        cnt = counts_dict.get(status, 0)
        if cnt:
            label = 'TSD' if status == 'Inprogress : TSD' else status
            parts.append(f'<span class="{css}">{icon} {label}: {cnt}</span>')
    if not parts:
        return '<span style="color:var(--text-light);font-size:0.75rem">—</span>'
    return '<div class="status-counts">' + ''.join(parts) + '</div>'


