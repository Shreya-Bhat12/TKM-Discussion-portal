def get_summary_data(vals):
    conn = get_db()
    cur = dict_cursor(conn)
    where_parts = ["is_deleted=0", "status != 'Closed'"]
    params = []
    if vals.get('part_name'):
        where_parts.append('"Part_Name" ILIKE %s'); params.append(f"%{vals['part_name']}%")
    if vals.get('model'):
        where_parts.append('"Model" ILIKE %s'); params.append(f"%{vals['model']}%")

    where_clause = " AND ".join(where_parts)
    sql = f"""
        SELECT
            "Part_Name", "Model",
            COUNT(*) AS total_cases,
            COUNT(*) FILTER (WHERE status='Open')        AS cnt_open,
            COUNT(*) FILTER (WHERE status='Open - QAC')  AS cnt_openqac,
            COUNT(*) FILTER (WHERE status='Open - TSD')  AS cnt_opentsd,
            COUNT(*) FILTER (WHERE status='Closed')      AS cnt_closed,
            MIN("Date_sent") AS earliest_date,
            COUNT(*) FILTER (
                WHERE "Date_sent" IS NOT NULL AND "Date_sent" != ''
                  AND (to_date("Date_sent", 'YYYY-MM-DD') + INTERVAL '3 days') < NOW()
            ) AS cnt_lead_crossed,
            COUNT(*) FILTER (
                WHERE "Date_sent" IS NOT NULL AND "Date_sent" != ''
                  AND (to_date("Date_sent", 'YYYY-MM-DD') + INTERVAL '3 days') >= NOW()
            ) AS cnt_lead_ok,
            COUNT(*) FILTER (WHERE "Date_sent" IS NULL OR "Date_sent" = '') AS cnt_no_date
        FROM shipments
        WHERE {where_clause}
        GROUP BY "Part_Name","Model"
    """
    having_parts = []
    if vals.get('status'):
        col_map = {
            'Open':       'cnt_open',
            'Open - QAC': 'cnt_openqac',
            'Open - TSD': 'cnt_opentsd',
            'Closed':     'cnt_closed',
        }
        col = col_map.get(vals['status'])
        if col:
            having_parts.append(f"{col} > 0")
    if vals.get('total_cases'):
        try:
            having_parts.append(f"COUNT(*) = {int(vals['total_cases'])}")
        except ValueError:
            pass
    if having_parts:
        sql += " HAVING " + " AND ".join(having_parts)
    sql += ' ORDER BY total_cases DESC, "Part_Name"'
    cur.execute(sql, params)
    data = cur.fetchall()
    conn.close()
    return data

def get_parts_for_group(part_name, model):
    conn = get_db()
    cur = dict_cursor(conn)
    cur.execute("""SELECT * FROM shipments
        WHERE is_deleted=0 AND status != 'Closed' AND "Part_Name"=%s AND "Model"=%s
        ORDER BY "Date_sent" DESC""", (part_name, model))
    rows = cur.fetchall()
    conn.close()
    return rows

def get_discussions_for_shipment(shipment_id):
    conn = get_db()
    cur = dict_cursor(conn)
    cur.execute("""SELECT * FROM "Discussion"
        WHERE shipment_id=%s AND is_deleted=0
        ORDER BY "Sl_No" ASC""", (shipment_id,))
    rows = cur.fetchall()
    conn.close()
    return rows

