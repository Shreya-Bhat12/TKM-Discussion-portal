        SELECT d.*, s."Part_Name"
        FROM "Discussion" d
        JOIN shipments s ON s."Sl_No" = d.shipment_id
        WHERE s.is_deleted = 0
        ORDER BY d.shipment_id ASC, d."Sl_No" ASC
